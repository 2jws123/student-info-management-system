# ============================================================
#  学生信息管理系统 - Git 忽略规则
# ============================================================

# 编译输出
target/
build/
out/
*.class

# H2 内嵌数据库文件（运行时自动生成，不应纳入版本库）
db/
*.mv.db
*.trace.db
*.lock.db

# 自动化截图：仓库中保留一份（可用 --screenshot 重新生成）

# IDE 配置
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project

# 操作系统
Thumbs.db
Desktop.ini
.DS_Store

# 日志与临时文件
*.log
*.tmp
*.bak
hs_err_pid*.log
replay_pid*.log

# Maven Wrapper 之外的本地仓库
.mvn/wrapper/maven-wrapper.jar
